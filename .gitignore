.pnpm-store/
backend/dist/
*.log
.symphony-workspaces/
symphony-state.json

# Third-party reference checkouts. `_reference/OpenClawTestBed` was a proprietary
# all-rights-reserved tree (Copyright (c) 2025 Tija) that also carried a git-crypt
# key and an encrypted secrets file; it was removed from the tree before
# open-sourcing. Keep local reference checkouts here, but never commit them.
_reference/
.worktrees/*/_reference/
.env
.env.local
build/

# Local secret/config overrides. NEVER commit these.
#
# The tracked `RemClaw/.env.*.xcconfig` files hold only values that are safe in a public
# repo — the API base URL, the Google OAuth *client* id (public by design), the IAP product
# id, and the PostHog `phc_` PROJECT key (a write-only ingestion key meant to ship inside
# the client app; it is extractable from any distributed build, so it is not a credential).
#
# Anything genuinely secret, or any value you want to point at your own account, goes in an
# untracked `.local.xcconfig` that the tracked file includes if present. That keeps a clone
# building out of the box while letting a contributor use their own PostHog project or
# backend without touching tracked files — and without a secret ever reaching a commit.
RemClaw/*.local.xcconfig
RemClawMac/*.local.xcconfig
BuildResults/
default.profraw

