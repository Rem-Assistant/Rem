{
  "name": "remclaw-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && cp -r src/db/migrations dist/db/",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "dev:local": "bash ./scripts/dev-local.sh",
    "migrate": "tsx src/db/run-migrations.ts",
    "test:integration": "vitest run src/routes/usage.integration.test.ts src/routes/brief-atomic.integration.test.ts src/services/routine-run-occurrence.store.integration.test.ts src/services/orchestrator-sweep.integration.test.ts src/services/pool-assignment-cleanup.integration.test.ts src/services/gateway-fly-app-ownership.integration.test.ts src/db/migrations/push-installation-rollout.integration.test.ts",
    "test:integration:watch": "vitest src/routes/usage.integration.test.ts src/routes/brief-atomic.integration.test.ts src/services/routine-run-occurrence.store.integration.test.ts src/services/orchestrator-sweep.integration.test.ts src/services/pool-assignment-cleanup.integration.test.ts src/services/gateway-fly-app-ownership.integration.test.ts src/db/migrations/push-installation-rollout.integration.test.ts",
    "patch:model:all": "tsx src/scripts/patch-default-model-all-gateways.ts",
    "patch:config:all": "tsx src/scripts/patch-config-all-gateways.ts",
    "sync:composio:all": "tsx src/scripts/sync-composio-mcp-all-gateways.ts",
    "revoke:channels": "tsx src/scripts/revoke-native-channels.ts",
    "canary:patch": "tsx src/scripts/patch-config-one-gateway.ts",
    "update:image:all": "tsx src/scripts/update-gateway-image-all.ts",
    "verify:image:rollout": "tsx src/scripts/verify-gateway-image-rollout.ts",
    "repair:pairings": "tsx src/scripts/repair-broken-pairings.ts",
    "pool:replenish": "tsx src/scripts/replenish-pool.ts",
    "pool:cleanup": "tsx src/scripts/cleanup-pool.ts",
    "pool:migrate": "tsx src/scripts/migrate-pooled-gateways.ts",
    "digests:run": "tsx src/scripts/run-digests.ts",
    "routines:run": "tsx src/scripts/run-routines.ts",
    "checkins:run": "tsx src/scripts/daily-checkins.ts",
    "signals:ingest": "tsx src/scripts/ingest-signals.ts",
    "orchestrator:sweep": "tsx src/scripts/run-orchestrator-sweep.ts",
    "brief:author": "tsx src/scripts/run-brief-authoring.ts",
    "brief:repair": "tsx src/scripts/repair-canonical-brief.ts",
    "memories:extract": "tsx src/scripts/extract-memories.ts",
    "keepwarm:run": "tsx src/scripts/run-keepwarm.ts",
    "runtime:prune": "tsx src/scripts/prune-rem-agent-runs.ts",
    "runtime:effects:reconcile": "tsx src/scripts/reconcile-rem-tool-effects.ts",
    "copy:user": "tsx src/scripts/copy-user-data.ts",
    "repoint:user": "tsx src/scripts/repoint-user-gateway.ts",
    "gateway:ownership:repair": "tsx src/scripts/repair-cross-environment-gateway-pointer.ts",
    "cron:all": "tsx src/scripts/cron-all.ts",
    "job:rollout": "npm run update:image:all -- --apply && npm run verify:image:rollout",
    "gen:gateway-schema-contract": "node scripts/gen-gateway-schema-contract.mjs"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^2.0.0",
    "@composio/core": "^0.14.0",
    "dotenv": "^16.6.1",
    "express": "^4.21.0",
    "google-auth-library": "^9.14.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "supertest": "^7.1.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
