# Local development environment (copied by developer to .env.local).
NODE_ENV=development
PORT=3000

# Required
DATABASE_URL=postgres://user:pass@localhost:5432/remclaw
JWT_SECRET=replace-with-random-secret
GATEWAY_ENCRYPTION_KEY=replace-with-strong-key

# Auth providers (this repo's iOS config values)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
APPLE_CLIENT_ID=com.remapp.rem

# Apple IAP Server API (development values)
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_BUNDLE_ID=com.remapp.rem
APPLE_IAP_APPLE_APP_ID=
# Comma-separated file paths to Apple root certificates (.cer/.der) for notification verification
APPLE_IAP_ROOT_CA_PATHS=
# true in production, false is acceptable in local sandbox testing
APPLE_IAP_ENABLE_ONLINE_CHECKS=false

# Optional backend telemetry
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Optional for local-only auth testing
# RAILWAY_API_TOKEN=
# RAILWAY_TEMPLATE_REPO=

# Managed Talk uses a two-phase rolling rollout. Leave false while any replica still runs the
# legacy wake/reconfigure writer; set true only after the fleet is fully on the fenced writer.
MANAGED_TALK_FENCED_WRITER_ROLLOUT_COMPLETE=false

# Optional quota overrides
# FREE_PLAN_DAILY_LIMIT=50
# FREE_PLAN_MONTHLY_LIMIT=500
# PRO_PLAN_DAILY_LIMIT=1000
# PRO_PLAN_MONTHLY_LIMIT=20000
