# Database
DATABASE_URL=postgresql://user:password@localhost:5432/remclaw
# Separate database used by `npm run test:integration` (defaults to DATABASE_URL if unset)
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/remclaw_test

# JWT Secret (generate with: openssl rand -hex 32)
JWT_SECRET=your-jwt-secret-here

# Gateway Encryption Key (generate with: openssl rand -hex 32)
GATEWAY_ENCRYPTION_KEY=your-encryption-key-here

# Auth Providers (optional)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Railway API (optional - for self-hosted Railway deploy)
RAILWAY_API_TOKEN=
RAILWAY_TEMPLATE_REPO=

# Fly.io Managed Deploy
FLY_ORG_TOKEN=your-fly-token
FLY_ORG_SLUG=personal
FLY_REGION=iad
FLY_GATEWAY_IMAGE=your-gateway-image:latest
BACKEND_PUBLIC_URL=https://your-backend.railway.app

# LLM Provider Keys
ANTHROPIC_API_KEY=your-anthropic-key
VENICE_API_KEY=
OPENAI_API_KEY=your-openai-key
DEFAULT_LLM_PROVIDER=anthropic

# GMI provider (OpenAI-compatible MaaS). Set DEFAULT_LLM_PROVIDER=gmi to use it.
GMI_API_KEY=
GMI_BASE_URL=
GMI_MODEL=
GMI_AGENTBOX_URL=

# ── Optional integrations (all feature-gated; leave blank to disable) ────────────
# Connectors (Composio)
COMPOSIO_API_KEY=
# Voice (ElevenLabs TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_API_KEY_GENERATION=
# Apple Push Notifications (APNs) — server key for push delivery
APNS_AUTH_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.remapp.rem
# macOS Apple Sign-In audience (the iOS one is APPLE_CLIENT_ID above)
APPLE_CLIENT_ID_MAC=com.remapp.rem.mac

# Apple IAP Server API (App Store Connect → Users and Access → Integrations → In-App Purchase)
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
# Keep literal \n in .env for multiline key
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_BUNDLE_ID=com.remapp.rem
APPLE_IAP_APPLE_APP_ID=
# Comma-separated file paths to Apple root certificates (.cer/.der) for notification verification
APPLE_IAP_ROOT_CA_PATHS=
# true in production, false is acceptable in local sandbox testing
APPLE_IAP_ENABLE_ONLINE_CHECKS=true

# Optional backend telemetry
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Testing only: lower free plan limits to hit quota quickly (e.g. FREE_PLAN_DAILY_LIMIT=3)
# FREE_PLAN_DAILY_LIMIT=3
# FREE_PLAN_MONTHLY_LIMIT=30
# PRO_PLAN_DAILY_LIMIT=1000
# PRO_PLAN_MONTHLY_LIMIT=20000

# Gateway Service Token (generate with: openssl rand -hex 32)
BACKEND_SERVICE_TOKEN=your-service-token-here

# Shared secret the gateway cron webhook presents when calling the inbound routine-run
# handler (POST /api/v1/internal/routines/:id/run). Unset => the handler rejects every
# call (fail-closed). Generate with: openssl rand -hex 32
ROUTINE_WEBHOOK_SECRET=your-routine-webhook-secret-here

# Local dev only: return these from GET /me/credentials when user has no gateway in DB (do not set in production)
# LOCAL_GATEWAY_URL=http://localhost:8080
# LOCAL_GATEWAY_TOKEN=optional — if not set, backend reads from ~/.openclaw/gateway.token (same as gateway wrapper)
# LOCAL_GATEWAY_STATE_DIR=optional — defaults to ~/.openclaw (match the gateway's OPENCLAW_STATE_DIR)
