<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Rem</string>
	<key>CFBundleName</key>
	<string>Rem</string>
	<key>APIBaseURL</key>
	<string>$(API_BASE_URL)</string>
	<key>SUFeedURL</key>
	<string>https://raw.githubusercontent.com/Rem-Assistant/RemClaw/main/appcast.xml</string>
	<!-- Custom URL scheme for OAuth callbacks (#377 Phase 1).
	     Mirrors the iOS registration in RemClaw/Info.plist. The
	     ASWebAuthenticationSession on Mac requires this to be declared
	     so the system routes remclaw:// callbacks back to this app. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>app.remclaw.mac</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>remclaw</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
